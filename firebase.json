{
  "hosting": {
    "public": "public",
    "predeploy": [
      "node -e \"const f=require('fs');f.mkdirSync('public',{recursive:true});f.copyFileSync('wadahqris.html','public/index.html')\""
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}
