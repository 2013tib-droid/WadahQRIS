rules_version = '2';

// ══════════════════════════════════════════════════════════════
//  WadahQRIS — Firestore Security Rules
//  Paste ke: Firebase Console → Firestore Database → Rules → Publish
//
//  Inti: keamanan ditegakkan DI SINI, di server.
//  Apa pun yang orang lakukan di browser (console, View Source,
//  edit HTML) tidak bisa menembus aturan ini.
// ══════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ── UID admin ────────────────────────────────────────────
    // Dari: Firebase Console → Authentication → Users → kolom "User UID"
    // Boleh lebih dari satu kalau pengurusnya banyak.
    function isAdmin() {
      return request.auth != null
          && request.auth.uid in [
               'AQnv50adjaZzw9ObgelOemNECS42'
             ];
    }

    match /qris/{docId} {

      // ── BACA ────────────────────────────────────────────────
      // Publik hanya boleh melihat yang sudah disetujui.
      // Antrean 'pending' tidak bisa diintip siapa pun.
      allow read: if isAdmin() || resource.data.status == 'approved';

      // ── UPLOAD (create) ─────────────────────────────────────
      // Siapa saja boleh menitipkan — tapi dengan syarat ketat.
      allow create: if
        // Wajib masuk antrean. Tidak ada yang bisa langsung menerbitkan.
        request.resource.data.status == 'pending'

        // Field yang diizinkan — persis ini, tidak boleh ada tambahan.
        // Gambar TIDAK lagi di sini; disimpan di koleksi 'qris_media'
        // supaya dokumen ini ringan & list tidak mengunduh base64.
        && request.resource.data.keys().hasOnly([
             'name','category','city','district','address',
             'waNumber','instagram',
             'status','uploadedAt'
           ])

        // Wajib ada dan bertipe benar
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 60

        && request.resource.data.category in ['masjid','yayasan','umkm','lainnya']

        && request.resource.data.city is string
        && request.resource.data.city.size() >= 2
        && request.resource.data.city.size() <= 40

        && request.resource.data.district is string
        && request.resource.data.district.size() <= 40

        && request.resource.data.address is string
        && request.resource.data.address.size() <= 140

        // Kontak opsional — divalidasi HANYA bila ada. Yang disimpan cuma
        // datanya (nomor digit / username IG), bukan URL; klien merangkai
        // wa.me & instagram.com sendiri.
        && (!('waNumber' in request.resource.data)
            || (request.resource.data.waNumber is string
                && (request.resource.data.waNumber == ''
                    || request.resource.data.waNumber.matches('^[0-9]{8,16}$'))))
        && (!('instagram' in request.resource.data)
            || (request.resource.data.instagram is string
                && request.resource.data.instagram.size() <= 30
                && (request.resource.data.instagram == ''
                    || request.resource.data.instagram.matches('^[A-Za-z0-9._]+$'))))

        // Timestamp harus dari server, tidak bisa dipalsukan
        && request.resource.data.uploadedAt == request.time;

      // ── UPDATE (setujui / perbaiki data) ────────────────────
      // Hanya admin. Dua bentuk perubahan yang diizinkan:
      //   (a) Setujui  → hanya mengubah 'status' menjadi 'approved'.
      //   (b) Perbaiki → hanya field teks (nama/kategori/kota/kecamatan/alamat),
      //                  dengan validasi yang sama seperti saat upload.
      // Gambar QRIS (dataUrl), foto pendukung, status, dan waktu unggah
      // TIDAK bisa diubah lewat edit — admin pun tak bisa diam-diam
      // menukar gambar QRIS-nya.
      allow update: if isAdmin() && (

        // (a) Setujui
        (
          request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['status'])
          && request.resource.data.status == 'approved'
        )

        ||

        // (b) Perbaiki data
        (
          request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['name','category','city','district','address','waNumber','instagram'])

          && request.resource.data.name is string
          && request.resource.data.name.size() >= 2
          && request.resource.data.name.size() <= 60

          && request.resource.data.category in ['masjid','yayasan','umkm','lainnya']

          && request.resource.data.city is string
          && request.resource.data.city.size() >= 2
          && request.resource.data.city.size() <= 40

          && request.resource.data.district is string
          && request.resource.data.district.size() <= 40

          && request.resource.data.address is string
          && request.resource.data.address.size() <= 140

          && (!('waNumber' in request.resource.data)
              || (request.resource.data.waNumber is string
                  && (request.resource.data.waNumber == ''
                      || request.resource.data.waNumber.matches('^[0-9]{8,16}$'))))
          && (!('instagram' in request.resource.data)
              || (request.resource.data.instagram is string
                  && request.resource.data.instagram.size() <= 30
                  && (request.resource.data.instagram == ''
                      || request.resource.data.instagram.matches('^[A-Za-z0-9._]+$'))))
        )
      );

      // ── HAPUS / TOLAK (delete) ──────────────────────────────
      // Hanya admin. Titik.
      allow delete: if isAdmin();
    }

    // ── COUNTER PENGUNJUNG (koleksi 'visits') ──────────────────
    // Satu dokumen per tanggal (ID: YYYY-MM-DD) berisi satu field
    // angka `n`. Tidak ada IP atau data pribadi yang disimpan.
    //
    // Publik hanya bisa MENAMBAH 1 — tidak bisa membaca, mengurangi,
    // melompat (+100), menambah field lain, atau memakai nama dokumen
    // di luar format tanggal. Membaca angkanya hanya admin.
    match /visits/{day} {

      allow read: if isAdmin();

      // Kunjungan pertama pada tanggal itu → dokumen baru, n harus 1.
      allow create: if day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['n'])
        && request.resource.data.n is int
        && request.resource.data.n == 1;

      // Kunjungan berikutnya → hanya boleh naik tepat 1.
      allow update: if day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['n'])
        && request.resource.data.n is int
        && request.resource.data.n == resource.data.n + 1;

      // Bersih-bersih (kalau perlu) hanya admin.
      allow delete: if isAdmin();
    }

    // ── GAMBAR (koleksi terpisah, id sama dgn dokumen qris) ─────
    //  Dipisah dari 'qris' supaya list (text-first) tidak ikut
    //  mengunduh base64. Gambar hanya diambil saat detail dibuka.
    match /qris_media/{docId} {

      // ── BACA ────────────────────────────────────────────────
      // Gambar hanya bisa dibaca kalau entri induknya sudah approved
      // (atau oleh admin). Antrean pending tetap tak bisa diintip.
      allow read: if isAdmin()
        || (exists(/databases/$(database)/documents/qris/$(docId))
            && get(/databases/$(database)/documents/qris/$(docId)).data.status == 'approved');

      // ── UPLOAD (create) ─────────────────────────────────────
      // Publik boleh mengunggah gambar saat menitipkan — dengan batas
      // ukuran & tipe ketat (mencegah file raksasa menghabiskan kuota).
      // Ditulis sebatch dengan dokumen 'qris' pending oleh klien.
      allow create: if
        request.resource.data.keys().hasOnly(['dataUrl','photoUrl'])

        // Foto QRIS wajib, harus benar-benar gambar JPEG base64, < ~600KB.
        && request.resource.data.dataUrl is string
        && request.resource.data.dataUrl.matches('^data:image/jpeg;base64,.*')
        && request.resource.data.dataUrl.size() < 600000

        // Foto pendukung opsional, batas ~400KB.
        && request.resource.data.photoUrl is string
        && request.resource.data.photoUrl.size() < 400000
        && (request.resource.data.photoUrl == ''
            || request.resource.data.photoUrl.matches('^data:image/jpeg;base64,.*'));

      // Gambar tidak bisa diubah — admin pun tak bisa menukar diam-diam.
      allow update: if false;

      // Hapus/tolak: hanya admin.
      allow delete: if isAdmin();

      // ── FOTO PENDUKUNG TAMBAHAN (ke-2 s/d ke-5) ──────────────
      // Foto pertama tetap di field photoUrl di atas. Sisanya satu dokumen
      // per foto (photos/2 … photos/5) karena 5 foto tak muat di satu
      // dokumen (batas 1MB Firestore).
      match /photos/{n} {

        // Sama dengan gambar induknya: hanya bila entri sudah approved.
        allow read: if isAdmin()
          || (exists(/databases/$(database)/documents/qris/$(docId))
              && get(/databases/$(database)/documents/qris/$(docId)).data.status == 'approved');

        // Hanya boleh ditulis SEBATCH dengan pembuatan entri baru:
        // dokumen qris induk belum ada sebelum batch, dan ada setelahnya.
        // Jadi orang tak bisa menempelkan foto ke entri yang sudah tayang.
        allow create: if n in ['2','3','4','5']
          && !exists(/databases/$(database)/documents/qris/$(docId))
          && existsAfter(/databases/$(database)/documents/qris/$(docId))
          && request.resource.data.keys().hasOnly(['url'])
          && request.resource.data.url is string
          && request.resource.data.url.size() < 400000
          && request.resource.data.url.matches('^data:image/jpeg;base64,.*');

        allow update: if false;
        allow delete: if isAdmin();
      }
    }

    // Semua koleksi lain: tertutup rapat.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
